# Copy to server/.env and fill in. Never commit server/.env.
# Ollama Cloud key: https://ollama.com/settings/keys
OLLAMA_API_KEY=
# OLLAMA_BASE_URL=https://ollama.com/v1
# Model trả lời chat (chỉ văn bản)
# CHAT_MODEL=gpt-oss:120b
# Model đọc ảnh: tin nhắn có đính kèm ảnh sẽ dùng model này thay cho CHAT_MODEL
# VISION_MODEL=gemma4:31b
# CHAT_PORT=3305
# CHAT_RATE_LIMIT=8
